{
    "name": "componenta/http-emitter",
    "description": "PSR-7 response emitter for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^3.0 || ^4.0",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore-abandoned": {
                "doctrine/annotations": "Transitive PHPBench development dependency; benchmarks use PHP attributes. Security advisories remain enforced."
            }
        }
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Http\\EmitterConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev",
            "dev-fix/http-response-audit": "2.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "nyholm/psr7": "^1.8.2",
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "phpbench/phpbench": "^1.7"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max --no-progress",
        "check": [
            "@test",
            "@phpstan"
        ],
        "benchmark": "@php vendor/bin/phpbench run --report=aggregate"
    }
}
