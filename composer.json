{
    "name": "componenta/http-emitter",
    "description": "PSR-7 response emitter for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^3.0.0",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Http\\EmitterConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php tests"
    }
}
